
SECRET_KEY=your-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=auth_service
DB_USER=auth_user
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
REDIS_URL=redis://localhost:6379/0

# Set these when the app should register itself in Eureka.
# In Docker Compose, EUREKA_INSTANCE_HOST should usually be the service name.
EUREKA_SERVER_URL=http://eureka-server:8761/eureka/
EUREKA_APP_NAME=auth-service
EUREKA_INSTANCE_HOST=localhost
EUREKA_INSTANCE_PORT=8000
EUREKA_HOME_PAGE_URL=/
EUREKA_STATUS_PAGE_URL=/info/
EUREKA_HEALTH_CHECK_URL=/health/

JWT_SECRET=your-jwt-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
JWT_ISSUER=auth-service
JWT_AUDIENCE=chat-services
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900
USER_SESSION_REGISTRY_TIMEOUT_SECONDS=604800
REVOKED_SESSION_MARKER_SECONDS=900
